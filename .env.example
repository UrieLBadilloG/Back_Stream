NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=generate-a-long-random-secret-and-keep-it-private
JWT_EXPIRES_IN=8h

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_FOLDER=streamly/courses

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=replace_me
DB_PASSWORD=replace_me
DB_NAME=replace_me
DB_CONNECTION_LIMIT=5
DB_CONNECT_TIMEOUT_MS=10000

# Pagos con Mercado Pago (Checkout Pro). Opcionales: sin ellos los pagos quedan deshabilitados.
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_WEBHOOK_SECRET=
# En producción (NODE_ENV=production) estas tres son obligatorias en la práctica:
#   MERCADOPAGO_WEBHOOK_SECRET: clave secreta del webhook (panel de Mercado Pago > Webhooks).
#   PUBLIC_API_URL: URL https pública de ESTE backend, p. ej. https://api.tudominio.com (sin / final).
#     Se usa en el webhook de pagos y en el enlace compartible /c/:slug (vista previa en WhatsApp/Facebook/LinkedIn).
#   APP_URL: URL https pública del frontend, p. ej. https://tudominio.com (a ella vuelve el comprador).
#     Se usa en las back_urls de pago, como destino de /c/:slug y en la URL de verificación de constancias (/verificar/<código>).
PUBLIC_API_URL=
APP_URL=
# Detrás de un proxy (Render, Railway, Nginx, Cloudflare) fija los saltos de proxy (normalmente 1).
# Sin esto el límite de peticiones ve la IP del proxy. Acepta un número o loopback/linklocal/uniquelocal. Nunca "true".
TRUST_PROXY=
# Solo pruebas locales con un Mercado Pago falso (npm run test:payments:e2e). Se IGNORA con NODE_ENV=production.
# MERCADOPAGO_API_BASE_URL=http://localhost:3199
